{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diablo-reference",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/index.html", "/d2r/data/*", "/d4/boss-timer", "/wiki", "/encyclopedia/*"]
  }
}
